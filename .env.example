# Copy to .env. Load it in your shell; SoMem does not read .env automatically.
SOMEM_BASE_URL=https://api.example.com/v1
SOMEM_API_KEY=
SOMEM_WRITER_MODEL=
# Empty Reader settings inherit the Writer settings.
SOMEM_READER_BASE_URL=
SOMEM_READER_API_KEY=
SOMEM_READER_MODEL=
# Empty means omit the effort parameter; accepted values depend on the provider.
SOMEM_WRITER_EFFORT=
SOMEM_READER_EFFORT=
